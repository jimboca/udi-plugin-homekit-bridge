{
    "name": "HomeKitBridge",
    "docs": "https://github.com/jimboca/udi-plugin-homekit-bridge",
    "type": "python3",
    "executable": "homekit-bridge-plugin.py",
    "install": "install.sh",
    "description": "Expose IoX devices to Apple Home via a HomeKit bridge",
    "notice": "Click Discover (or set Advertise On) to open a timed pairing window, then use Show HomeKit Setup for the QR code / PIN in Plugins Notices.",
    "persist_folder": "config",
    "logLevel": "INFO",
    "shortPoll": "30",
    "longPoll": "300",
    "discover": true,
    "customParams": {
        "export_mode": "spoken",
        "mapping_mode": "common",
        "hap_port": "51826",
        "hap_pin": "",
        "bridge_name": "IoX Bridge",
        "advertise_ip": "",
        "advertise_timeout": "5"
    },
    "profile_version": "1.0.0"
}
